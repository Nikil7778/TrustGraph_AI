PROJECT_NAME="SkillPath AI Backend"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database connection URL (PostgreSQL default, or SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillpath_db"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Phase 11 — Gemini AI Layer Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=15
