# SkillPath AI - Environment Variables Reference
PROJECT_NAME="SkillPath AI Backend"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database Configuration (PostgreSQL in production, or SQLite default for local demo)
DATABASE_URL="sqlite:///d:/SkillPath_AI/backend/skillpath.db"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Gemini AI Layer Configuration (Optional - automated deterministic fallbacks engage if omitted)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=15
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/login"